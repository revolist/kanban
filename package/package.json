{
  "name": "@revolist/kanban-community",
  "version": "4.0.9",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/kanban-community.umd.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/kanban-community.umd.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./core/*": {
      "types": "./dist/core/*.d.ts",
      "import": "./dist/core/*.js",
      "require": "./dist/core/index.cjs"
    },
    "./styles.css": "./dist/kanban-community.css",
    "./internal/*": {
      "types": "./dist/internal/*.d.ts",
      "import": "./dist/internal/*.js",
      "require": "./dist/kanban-community.umd.cjs"
    },
    "./editor.scss": "./dist/editor.scss",
    "./toolbar.scss": "./dist/toolbar.scss"
  },
  "peerDependencies": {
    "@revolist/revogrid": "^4.31.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/revolist/kanban.git",
    "directory": "package"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "@revolist/grid-runtime": "^4.0.9",
    "@revolist/ui": "^4.0.9",
    "preact": "10.29.1"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "module": "./dist/index.js"
}
