{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "rootDir": "package",
    "outDir": "package/dist",
    "types": [],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "noEmitOnError": true
  },
  "include": ["package/**/*.ts", "package/**/*.tsx"],
  "exclude": ["package/dist", "node_modules", "**/*.test.ts", "**/*.test.tsx"]
}
